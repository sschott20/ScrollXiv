<svg width="512" height="512" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="512" height="512" fill="#3b82f6" rx="80"/>
  
  <!-- Scroll icon (paper stack) -->
  <g transform="translate(128, 96)">
    <!-- Back paper -->
    <rect x="20" y="20" width="200" height="280" rx="8" fill="#93c5fd" opacity="0.5"/>
    
    <!-- Middle paper -->
    <rect x="10" y="10" width="200" height="280" rx="8" fill="#60a5fa" opacity="0.7"/>
    
    <!-- Front paper -->
    <rect x="0" y="0" width="200" height="280" rx="8" fill="#eff6ff"/>
    
    <!-- Text lines on front paper -->
    <line x1="20" y1="40" x2="180" y2="40" stroke="#3b82f6" stroke-width="8" stroke-linecap="round"/>
    <line x1="20" y1="70" x2="160" y2="70" stroke="#3b82f6" stroke-width="8" stroke-linecap="round"/>
    <line x1="20" y1="100" x2="180" y2="100" stroke="#3b82f6" stroke-width="6" stroke-linecap="round" opacity="0.6"/>
    <line x1="20" y1="130" x2="140" y2="130" stroke="#3b82f6" stroke-width="6" stroke-linecap="round" opacity="0.6"/>
    <line x1="20" y1="160" x2="170" y2="160" stroke="#3b82f6" stroke-width="6" stroke-linecap="round" opacity="0.6"/>
    
    <!-- Icon/figure representation -->
    <rect x="50" y="190" width="100" height="60" rx="4" fill="#dbeafe" stroke="#3b82f6" stroke-width="3"/>
    <circle cx="75" cy="215" r="8" fill="#3b82f6"/>
    <polyline points="60,235 75,220 90,230 110,210" fill="none" stroke="#3b82f6" stroke-width="3"/>
  </g>
</svg>
